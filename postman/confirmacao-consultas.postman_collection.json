          "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"profissional@teste.com\",\n  \"password\": \"Senha@123\"\n}"},"url":"{{baseUrl}}/api/v1/auth/login"}
