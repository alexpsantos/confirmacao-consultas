  "item": [
    {
      "name": "Autenticação",
      "description": "Gera e salva automaticamente um token separado para cada perfil.",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{authTenantId}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login ADMIN: status 200', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const body = pm.response.json();",
                "  pm.expect(body.role).to.eql('ADMIN');",
                "  pm.collectionVariables.set('adminToken', body.accessToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login OWNER",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{authTenantId}}\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login OWNER: status 200', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const body = pm.response.json();",
                "  pm.expect(body.role).to.eql('OWNER');",
                "  pm.collectionVariables.set('ownerToken', body.accessToken);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login PROFESSIONAL",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{authTenantId}}\",\n  \"email\": \"{{professionalEmail}}\",\n  \"password\": \"{{professionalPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login PROFESSIONAL: status 200', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const body = pm.response.json();",
                "  pm.expect(body.role).to.eql('PROFESSIONAL');",
                "  pm.collectionVariables.set('professionalToken', body.accessToken);",
                "}"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Criar tenant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Clínica Postman {{$randomInt}}\",\n  \"timezone\": \"America/Sao_Paulo\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/tenants",
            "description": "Cria um tenant e salva o id retornado em tenantId."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) pm.collectionVariables.set('tenantId', pm.response.json().id);"
              ]
            }
          }]
        },
        {
          "name": "Listar todos os tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenants?page=0&size=20&sort=displayName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tenants"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "displayName,asc" }
              ]
            },
            "description": "Sem active, retorna ativos e inativos. Altere page, size e sort nos parâmetros."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Resposta paginada', () => pm.expect(pm.response.json().content).to.be.an('array'));"
              ]
            }
          }]
        },
        {
          "name": "Listar tenants ativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenants?active=true&page=0&size=20&sort=displayName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tenants"],
              "query": [
                { "key": "active", "value": "true" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "displayName,asc" }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Somente ativos', () => pm.response.json().content.forEach(item => pm.expect(item.active).to.eql(true)));"
              ]
            }
          }]
        },
        {
          "name": "Listar tenants inativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenants?active=false&page=0&size=20&sort=displayName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tenants"],
              "query": [
                { "key": "active", "value": "false" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "displayName,asc" }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Somente inativos', () => pm.response.json().content.forEach(item => pm.expect(item.active).to.eql(false)));"
              ]
            }
          }]
        },
        {
          "name": "Buscar tenant por ID",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('ID correto', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('tenantId')));"
              ]
            }
          }]
        },
        {
          "name": "Atualizar tenant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Clínica Postman Atualizada\",\n  \"timezone\": \"America/Sao_Paulo\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Nome atualizado', () => pm.expect(pm.response.json().displayName).to.eql('Clínica Postman Atualizada'));"
              ]
            }
          }]
        },
        {
          "name": "Desativar tenant",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] }
          }]
        },
        {
          "name": "Ativar tenant",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/activate" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] }
          }]
        }
      ]
    },
