    { "key": "professionalId", "value": "644cbf7d-f57d-4974-b20e-b3db333de411", "type": "string" },
    { "key": "adminEmail", "value": "admin@confirmacao.com", "type": "string" },
    { "key": "adminPassword", "value": "", "type": "string" },
    { "key": "ownerEmail", "value": "owner@confirmacao.com", "type": "string" },
    { "key": "ownerPassword", "value": "", "type": "string" },
