        {"name":"Atualizar meu perfil","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"fullName\": \"Profissional Teste\",\n  \"email\": \"profissional@teste.com\",\n  \"phone\": \"11999999999\",\n  \"registrationNumber\": \"CRP-TESTE\"\n}"},"url":"{{baseUrl}}/api/v1/professionals/me"}}
